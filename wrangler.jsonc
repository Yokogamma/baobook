// Cloudflare Workers Static Assets: public/ is served as it is, and the small Worker in worker/ answers only paths under /__/
// (the Firebase Auth proxy of docs/SYNC-PLAN.md §4.12). One repository, two Workers:
//   development  "baobook"       ← branch main  (npx wrangler deploy)            → https://baobook.matamata.dev
//   production   "baobook-prod"  ← branch prod  (npx wrangler deploy --env prod) → https://baobook.matamata.app
// A release is a pull request main → prod, merged only after the change was checked on .dev.
// Other branches → npx wrangler preview, which needs the "previews" block (empty: assets and compatibility stay at the top level)
{
  "name": "baobook",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/__/*"]
  },
  "routes": [
    { "pattern": "baobook.matamata.dev", "custom_domain": true }
  ],
  "previews": {},
  "env": {
    // routes are not inherited from the top level; main, assets and compatibility_date are
    "prod": {
      "name": "baobook-prod",
      "routes": [
        { "pattern": "baobook.matamata.app", "custom_domain": true }
      ]
    }
  }
}
